{
  "name": "babji-flow-windows",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first dictation and meeting notes for Windows",
  "author": "Babji Flow",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.babji.flow.windows",
    "productName": "Babji Flow",
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "src/native.ps1"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "BabjiFlow-${version}-windows-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "BabjiFlow-${version}-Setup-windows-${arch}.${ext}"
    }
  }
}
